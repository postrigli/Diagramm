    <!-- Shizuku setup guide -->
    <string name="guide_title">Setting up Shizuku</string>
    <string name="guide_intro">Do these steps once. Ticks appear by themselves as each step is done.</string>
    <string name="guide_install_title">Install Shizuku</string>
    <string name="guide_install_body">A free app that lets Diagramm remove apps and clear their cache without confirmation windows.</string>
    <string name="guide_start_title">Start the Shizuku service</string>
    <string name="guide_start_body">Open Shizuku and tap Start. If your phone is rooted, start it with root. Without root: 1) Settings → About phone → Software information → tap \"Build number\" 7 times to enable Developer options; 2) Developer options → turn on \"Wireless debugging\" (Wi-Fi is required); 3) in Shizuku choose pairing and enter the code from \"Pair device with pairing code\"; 4) go back and tap Start. After every phone restart the service has to be started again.</string>
    <string name="guide_allow_title">Allow Diagramm to use Shizuku</string>
    <string name="guide_allow_body">Tap the button: Shizuku shows a request, choose \"Allow all the time\".</string>
    <string name="guide_usage_title">Special access: Usage access</string>
    <string name="guide_usage_body">Needed to read app sizes. If the switch is grey and says \"Controlled by restricted settings\" (it happens with APKs installed outside a store): Settings → Apps → Diagramm → ⋮ (top right) → \"Allow restricted settings\", then turn the access on: Settings → Apps → ⋮ → Special access → Usage data access → Diagramm. If the ⋮ menu has no such item, tap the grey switch once first.</string>
    <string name="guide_usage_open">Open Usage access</string>
    <string name="guide_app_info">App settings</string>
    <string name="guide_battery_title">Battery (recommended on Samsung)</string>
    <string name="guide_battery_body">So that One UI does not stop Shizuku in the background: Settings → Apps → Shizuku → Battery → \"Unrestricted\".</string>
